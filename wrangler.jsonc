{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "bee-ai-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
